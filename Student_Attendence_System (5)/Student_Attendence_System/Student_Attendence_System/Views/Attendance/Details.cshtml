@model Student_Attendence_System.Models.Attendance

@{
    ViewData["Title"] = "Attendance Details";
}

<div class="page-header">

    <div>

        <h1>
            Attendance Details
        </h1>

        <p>
            Attendance record information.
        </p>

    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        ← Back

    </a>

</div>


<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card">

            <div class="card-header">
                Attendance Record
            </div>

            <div class="card-body">

                <div class="detail-row">

                    <span class="detail-label">
                        Student
                    </span>

                    <span class="detail-value">
                        @Model.Student?.Name
                    </span>

                </div>


                <div class="detail-row">

                    <span class="detail-label">
                        Enrollment
                    </span>

                    <span class="detail-value">
                        @Model.Student?.EnrollmentNo
                    </span>

                </div>


                <div class="detail-row">

                    <span class="detail-label">
                        Date
                    </span>

                    <span class="detail-value">
                        @Model.AttendanceDate.ToString(
                            "dd MMMM yyyy")
                    </span>

                </div>


                <div class="detail-row">

                    <span class="detail-label">
                        Time
                    </span>

                    <span class="detail-value">
                        @Model.AttendanceTime.ToString(
                            "hh:mm:ss tt")
                    </span>

                </div>


                <div class="detail-row">

                    <span class="detail-label">
                        Status
                    </span>

                    <span class="detail-value">

                        <span class="badge bg-success">
                            @Model.Status
                        </span>

                    </span>

                </div>


                <div class="detail-row">

                    <span class="detail-label">
                        Method
                    </span>

                    <span class="detail-value">
                        @Model.Method
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>