@{
    ViewData["Title"] = "Privacy";
}

<div class="page-header">

    <div>

        <h1>
            Privacy & Security
        </h1>

        <p>
            Information about local face recognition.
        </p>

    </div>

</div>


<div class="row g-4">

    <div class="col-lg-8">

        <div class="card">

            <div class="card-body">

                <h4>
                    Local Face Recognition
                </h4>

                <p class="text-muted mt-3">

                    The application uses a local face-recognition
                    engine for attendance processing.

                </p>


                <div class="alert alert-info">

                    <strong>
                        Local processing
                    </strong>

                    <br />

                    Face recognition requests are sent to the
                    local recognition service rather than a
                    cloud face-recognition API.

                </div>


                <h5 class="mt-4">
                    Biometric Data
                </h5>

                <p class="text-muted">

                    Face embeddings are sensitive biometric
                    information and should be protected,
                    access-controlled, and deleted when no
                    longer required.

                </p>

            </div>

        </div>

    </div>


    <div class="col-lg-4">

        <div class="card">

            <div class="card-body">

                <h5>
                    Security
                </h5>

                <ul class="text-muted mt-3">

                    <li class="mb-2">
                        Role-based access
                    </li>

                    <li class="mb-2">
                        Faculty-only administration
                    </li>

                    <li class="mb-2">
                        Student-specific attendance access
                    </li>

                    <li>
                        Local recognition service
                    </li>

                </ul>

            </div>

        </div>

    </div>

</div>