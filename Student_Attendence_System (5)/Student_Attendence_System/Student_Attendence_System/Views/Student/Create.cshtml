@model Student_Attendence_System.Models.Student

@{
    ViewData["Title"] = "Add Student";
}

<div class="page-header">

    <div>

        <h1>
            Add Student
        </h1>

        <p>
            Create a new student profile.
        </p>

    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        ← Back

    </a>

</div>


<div class="row justify-content-center">

    <div class="col-xl-8">

        <div class="card">

            <div class="card-header">
                Student Information
            </div>

            <div class="card-body">

                <form asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>


                    <div class="row g-3">

                        <div class="col-md-6">

                            <label asp-for="EnrollmentNo"
                                   class="form-label">
                            </label>

                            <input asp-for="EnrollmentNo"
                                   class="form-control"
                                   placeholder="Example: 24CEUOS038" />

                            <span asp-validation-for="EnrollmentNo"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="Name"
                                   class="form-label">
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Full name" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="student@example.com" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label for="password"
                                   class="form-label">
                                Student Password
                            </label>

                            <input id="password"
                                   name="password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter student password"
                                   required />

                        </div>


                        <div class="col-md-6">

                            <label asp-for="ClassName"
                                   class="form-label">
                            </label>

                            <input asp-for="ClassName"
                                   class="form-control"
                                   placeholder="Example: BCA-3" />

                        </div>

                    </div>


                    <div class="alert alert-info mt-4">

                        <strong>Next step:</strong>

                        After creating the student, use
                        <strong>Register Face</strong>
                        to register the local face template.

                    </div>


                    <div class="d-flex
                                justify-content-end
                                gap-2
                                mt-4">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-primary">

                            Create Student

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}