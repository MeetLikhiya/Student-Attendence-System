@model IEnumerable<Student_Attendence_System.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="page-header">

    <div>

        <h1>
            Students
        </h1>

        <p>
            Manage student profiles and biometric registration.
        </p>

    </div>

    <a asp-action="Create"
       class="btn btn-primary">

        + Add Student

    </a>

</div>


<div class="card">

    <div class="card-header">

        <div class="d-flex
                    justify-content-between
                    align-items-center
                    gap-3
                    flex-wrap">

            <div>

                <strong>
                    Student Directory
                </strong>

                <div class="text-muted"
                     style="font-size:12px">

                    @Model.Count() student(s)

                </div>

            </div>

            <input id="studentSearch"
                   type="search"
                   class="form-control"
                   style="max-width:280px"
                   placeholder="Search students..." />

        </div>

    </div>


    <div class="card-body p-0">

        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table"
                       id="studentTable">

                    <thead>

                    <tr>

                        <th>
                            Student
                        </th>

                        <th>
                            Enrollment
                        </th>

                        <th>
                            Class
                        </th>

                        <th>
                            Email
                        </th>

                        <th>
                            Face
                        </th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                    </thead>

                    <tbody>

                    @foreach (var student in Model)
                    {
                        <tr>

                            <td>

                                <div class="fw-semibold">
                                    @student.Name
                                </div>

                                <small class="text-muted">
                                    ID #@student.Id
                                </small>

                            </td>

                            <td>
                                @student.EnrollmentNo
                            </td>

                            <td>
                                @(student.ClassName ?? "—")
                            </td>

                            <td>
                                @(student.Email ?? "—")
                            </td>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(
                                    student.FaceData))
                                {
                                    <span class="badge bg-success">
                                        Registered
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Not registered
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="d-flex
                                            justify-content-end
                                            gap-1">

                                    <a asp-action="Details"
                                       asp-route-id="@student.Id"
                                       class="btn btn-sm btn-outline-secondary">

                                        View

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@student.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        Edit

                                    </a>

                                    <a asp-action="RegisterFace"
                                       asp-route-id="@student.Id"
                                       class="btn btn-sm btn-primary">

                                        Face

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <div class="empty-state-icon">
                    ♙
                </div>

                <h3>
                    No students yet
                </h3>

                <p>
                    Add your first student to start
                    managing attendance.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">

                    Add Student

                </a>

            </div>
        }

    </div>

</div>


@section Scripts {

<script>

    const search =
        document.getElementById("studentSearch");

    const table =
        document.getElementById("studentTable");

    if (search && table) {

        search.addEventListener("input", function () {

            const value =
                this.value.toLowerCase();

            table
                .querySelectorAll("tbody tr")
                .forEach(row => {

                    row.style.display =
                        row.innerText
                            .toLowerCase()
                            .includes(value)
                            ? ""
                            : "none";

                });

        });

    }

</script>

}